#!/bin/sh
# analyzer.sh

LOG_FILE="/root/analyzer.log"
TMP_OUT="/tmp/analyzer.raw"

# Цвета
CLR_OFF="\033[0m"; RED_BRIGHT="\033[1;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"
IFACE="awg10"

clear
{
echo ""
# 1. Сбор данных
LOAD=$(uptime | awk -F'load average:' '{ print $2 }' | cut -d, -f1 | sed 's/ //g')
MEM_T=$(free | grep Mem | awk '{print $2}')
MEM_U=$(free | grep Mem | awk '{print $3}')
MEM_P=$((MEM_U * 100 / MEM_T))
LAN_IP=$(ip addr show br-lan 2>/dev/null | grep -w inet | awk '{print $2}' | cut -d/ -f1)
[ -z "$LAN_IP" ] && LAN_IP=$(uci -q get network.lan.ipaddr)
NAND_PART=$(df | grep -q "/overlay" && echo "/overlay" || echo "/")
NAND_PCT=$(df -h "$NAND_PART" | awk 'NR==2 {print $5}')
NAND_FREE=$(df -h "$NAND_PART" | awk 'NR==2 {print $4}')

echo "== АНАЛИЗ КОНФИГУРАЦИЙ (YOUTUBE + GOOGLEVIDEO)"
echo "=============================================================="

for cfg in zeroblock podkop zapret youtubeUnblock; do
    file="/etc/config/$cfg"
    [ ! -f "$file" ] && continue
    
    if [ "$cfg" = "youtubeUnblock" ]; then
        any_found=0
        sections=$(uci show youtubeUnblock | grep "=section" | cut -d. -f2 | cut -d= -f1)
        for s in $sections; do
            if [ "$(uci -q get youtubeUnblock."$s".enabled)" = "1" ]; then
                match=$(uci show youtubeUnblock."$s" | grep -Ei "youtube|googlevideo\.com")
                if [ -n "$match" ]; then
                    any_found=1; count=$(echo "$match" | wc -l)
                    s_name=$(uci -q get youtubeUnblock."$s".name); [ -z "$s_name" ] && s_name="$s"
                    printf "  %-15s найден в: ${YELLOW}%-25s${CLR_OFF} [${GREEN}✔${CLR_OFF}] (%d)\n" "$cfg" "$s_name" "$count"
                fi
            fi
        done
        [ "$any_found" -eq 0 ] && printf "  %-15s ютуб найден: 0\n" "$cfg"
    elif [ "$cfg" = "zapret" ]; then
        zap_any=0
        main_count=$(grep -Ei "youtube|googlevideo\.com" "$file" | wc -l)
        [ "$main_count" -gt 0 ] && zap_any=1 && printf "  %-15s найден в: ${YELLOW}%-25s${CLR_OFF} (%d)\n" "$cfg" "$cfg" "$main_count"
        extra_files=$(grep -o "\-\-hostlist=[^ ]*" "$file" | cut -d= -f2 | sed "s/['\"]//g")
        for ef in $extra_files; do
            if [ -f "$ef" ]; then
                ecount=$(grep -Ei "youtube|googlevideo\.com" "$ef" | wc -l)
                if [ "$ecount" -gt 0 ]; then
                    zap_any=1; fname=$(basename "$ef")
                    printf "  %-15s найден в: ${YELLOW}%-25s${CLR_OFF} (%d)\n" "$cfg" "$fname" "$ecount"
                fi
            fi
        done
        [ "$zap_any" -eq 0 ] && printf "  %-15s ютуб найден: 0\n" "$cfg"
    else
        count=$(grep -Ei "youtube|googlevideo\.com" "$file" | wc -l)
        [ "$count" -gt 0 ] && printf "  %-15s найден в: ${YELLOW}%-25s${CLR_OFF} (%d)\n" "$cfg" "$cfg" "$count" || printf "  %-15s ютуб найден: 0\n" "$cfg"
    fi
done

echo ""
echo "== СТАТУС СЛУЖБ"
echo "=============================================================="
for s in zeroblock youtubeUnblock zapret ruantiblock podkop sing-box; do
    if [ -f "/etc/init.d/$s" ]; then
        ST_OUT=$(/etc/init.d/$s status 2>&1 | tr '\n' ' ' | sed 's/  */ /g' | sed 's/^ //;s/ $//')
        if [ "$s" = "zeroblock" ]; then
            echo "$ST_OUT" | grep -q "running" || ST_OUT="unknown (status N/A)"
        fi
        if echo "$ST_OUT" | grep -Ei "running|active" >/dev/null; then
            ST_CLR="${GREEN}"
        else
            ST_CLR="${RED_BRIGHT}"
        fi
        /etc/init.d/$s enabled 2>/dev/null && { au_txt="РАЗРЕШЁН"; au_clr="${GREEN}"; } || { au_txt="ОТКЛ"; au_clr="${RED_BRIGHT}"; }
        printf "  %-15s | " "$s"
        printf "${ST_CLR}%-25s${CLR_OFF}" "$ST_OUT"
        printf " | ${au_clr}${au_txt}${CLR_OFF}\n"
    fi
done

echo ""
echo "== ПРОВЕРКА PROXY (SING-BOX / OPERA)"
echo "=============================================================="
TEST_URL="https://youtube.com"
PROXY_ADDR="127.0.0.1:18080"
P_RESP=$(curl -I -s --connect-timeout 3 -x http://$PROXY_ADDR $TEST_URL | head -n 1 | tr -d '\r\n')

printf "  URL: %s (%s)\n" "$TEST_URL" "$PROXY_ADDR"
if [ -z "$P_RESP" ]; then
    printf "  Статус прокси:%b\n" " ${RED_BRIGHT}ОФЛАЙН${CLR_OFF} (ОШИБКА ПОДКЛЮЧЕНИЯ)"
else
    printf "  Статус прокси:%b\n" " ${GREEN}ОНЛАЙН${CLR_OFF} ($P_RESP)"
fi

echo ""
echo "== ИНТЕРФЕЙС $IFACE"
echo "=============================================================="
if [ -d "/sys/class/net/$IFACE" ]; then
    [ -n "$(ip link show $IFACE | grep 'UP')" ] && IF_STATUS="${GREEN}UP (ON)${CLR_OFF}" || IF_STATUS="${RED_BRIGHT}DOWN (OFF)${CLR_OFF}"
    printf "  Статус:      %b\n" "$IF_STATUS"
    RX_B=$(cat /sys/class/net/$IFACE/statistics/rx_bytes)
    TX_B=$(cat /sys/class/net/$IFACE/statistics/tx_bytes)
    printf "  Получено:    %.2f MB\n" "$(echo $RX_B | awk '{print $1/1048576}')"
    printf "  Отправлено:  %.2f MB\n" "$(echo $TX_B | awk '{print $1/1048576}')"

    printf "  Пинг (ya.ru via $IFACE): "
    P_D=$(ping -I $IFACE -c 4 ya.ru 2>/dev/null)
    if [ $? -eq 0 ]; then
        STATS=$(echo "$P_D" | grep "round-trip" | sed 's/[=/]/ /g' | awk '{printf "%.1f/%.1f ms", $(NF-3), $(NF-1)}')
        LOSS=$(echo "$P_D" | grep -o "[0-9]*% packet loss" | awk '{print $1}')
        L_VAL=$(echo "$LOSS" | tr -d '%')
        if [ "$L_VAL" -eq 0 ]; then
            printf "${GREEN}%s (%s loss)${CLR_OFF}\n" "$STATS" "$LOSS"
        else
            printf "${YELLOW}%s (%s loss)${CLR_OFF}\n" "$STATS" "$LOSS"
        fi
    else
        printf "${RED_BRIGHT}ERROR (100%% loss)${CLR_OFF}\n"
    fi
else
    echo "  Интерфейс $IFACE не найден."
fi

echo ""
echo "== ПРОВЕРКА DNS"
echo "=============================================================="
NS_L=$(nslookup facebook.com 2>/dev/null)
DNS_SRV=$(echo "$NS_L" | grep "Server:" | awk '{print $2}')
FB_IP=$(echo "$NS_L" | grep "Address" | tail -n 1 | awk '{print $NF}' | cut -d: -f1)

DNS_FWD=$(uci -q get dhcp.@dnsmasq[0].server | awk '{print $1}' | sed "s/'//g")
[ -z "$DNS_FWD" ] && DNS_R_ST="${RED_BRIGHT} NOT FOUND${CLR_OFF}" || DNS_R_ST="${GREEN} ${DNS_FWD}${CLR_OFF}"

printf "  DNS Server:  %s\n" " ${DNS_SRV}:53"
printf "  DNS Redirect:%b\n" "$DNS_R_ST"
[ -z "$FB_IP" ] && RES="${RED_BRIGHT} FAILED${CLR_OFF}" || RES="${YELLOW} ${FB_IP}${CLR_OFF}"
printf "  Facebook IP: %b\n" "$RES"

echo ""
echo "== СИСТЕМНЫЕ РЕСУРСЫ"
echo "=============================================================="
printf "  LAN IP:     %s\n" "$LAN_IP"
printf "  CPU LOAD:   %s\n" "$LOAD"
printf "  RAM USED:   %s%%\n" "$MEM_P"
printf "  NAND USED:  %s (%s free)\n" "$NAND_PCT" "$NAND_FREE"
echo "=============================================================="

} | tee "$TMP_OUT"

sed 's/\x1b\[[0-9;]*m//g' "$TMP_OUT" > "$LOG_FILE"
rm "$TMP_OUT"

printf "  ${YELLOW}Путь к логу: %s${CLR_OFF}\n" "$LOG_FILE"
echo ""
