#!/bin/sh

# Очистка экрана
clear

# Коды цветов
CLR_OFF="\033[0m"
RED_BRIGHT="\033[1;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"

# 1. Сбор системных данных
LOAD=$(uptime | awk -F'load average:' '{ print $2 }' | cut -d, -f1 | sed 's/ //g')
MEM_TOTAL=$(free | grep Mem | awk '{print $2}')
MEM_USED=$(free | grep Mem | awk '{print $3}')
MEM_PCT=$((MEM_USED * 100 / MEM_TOTAL))

# 2. Проверка интерфейса и пинга
if [ ! -d "/sys/class/net/awg10" ]; then
    PING_RES="${RED_BRIGHT}NOT FOUND${CLR_OFF}"
else
    printf "Проверка связи через awg10..."
    PING_DATA=$(ping -I awg10 -c 4 ya.ru 2>/dev/null)
    if [ $? -eq 0 ]; then
        STATS=$(echo "$PING_DATA" | grep "round-trip" | sed 's/[=/]/ /g' | awk '{printf "%.1f/%.1f ms", $(NF-3), $(NF-1)}')
        PING_RES="${GREEN}$STATS${CLR_OFF}"
    else
        PING_RES="${RED_BRIGHT}ERROR${CLR_OFF}"
    fi
    printf "\r                             \r"
fi

echo "=============================================================="
echo "   АНАЛИЗ КОНФИГУРАЦИЙ (YOUTUBE + GOOGLEVIDEO)"
echo "--------------------------------------------------------------"

# 3. Анализ файлов
google_warn=""
for cfg in zeroblock podkop zapret youtubeUnblock; do
    file="/etc/config/$cfg"
    if [ -f "$file" ]; then
        
        if [ "$cfg" = "youtubeUnblock" ]; then
            any_found=0
            sections=$(uci show youtubeUnblock | grep "=section" | cut -d. -f2 | cut -d= -f1)
            for s in $sections; do
                enabled=$(uci -q get youtubeUnblock."$s".enabled)
                if [ "$enabled" = "1" ]; then
                    match=$(uci show youtubeUnblock."$s" | grep -Ei "youtube|googlevideo\.com")
                    if [ -n "$match" ]; then
                        any_found=1
                        count=$(echo "$match" | wc -l)
                        s_name=$(uci -q get youtubeUnblock."$s".name)
                        [ -z "$s_name" ] && s_name="$s"
                        printf "%-15s найден в: ${YELLOW}%s${CLR_OFF} (${YELLOW}%d${CLR_OFF})\n" "$cfg" "$s_name" "$count"
                    fi
                fi
            done
            # Если в файле вообще ничего не включено
            [ "$any_found" -eq 0 ] && printf "%-15s ютуб найден: 0\n" "$cfg"
            
        else
            # Стандартный поиск для остальных (построчно для zapret внешних файлов)
            main_count=$(grep -Ei "youtube|googlevideo\.com" "$file" | wc -l)
            if [ "$main_count" -gt 0 ]; then
                printf "%-15s найден в: ${YELLOW}%s${CLR_OFF} (${YELLOW}%d${CLR_OFF})\n" "$cfg" "$cfg" "$main_count"
            else
                # Если в самом конфиге 0, но это zapret, проверим его файлы ниже
                [ "$cfg" != "zapret" ] && printf "%-15s ютуб найден: 0\n" "$cfg"
            fi
            
            if [ "$cfg" = "zapret" ]; then
                extra_files=$(grep -o "\-\-hostlist=[^ ]*" "$file" | cut -d= -f2 | sed "s/['\"]//g")
                zap_any=0
                [ "$main_count" -gt 0 ] && zap_any=1
                
                for ef in $extra_files; do
                    if [ -f "$ef" ]; then
                        ecount=$(grep -Ei "youtube|googlevideo\.com" "$ef" | wc -l)
                        if [ "$ecount" -gt 0 ]; then
                            zap_any=1
                            fname=$(basename "$ef")
                            printf "%-15s найден в: ${YELLOW}%s${CLR_OFF} (${YELLOW}%d${CLR_OFF})\n" "$cfg" "$fname" "$ecount"
                        fi
                    fi
                done
                [ "$zap_any" -eq 0 ] && printf "%-15s ютуб найден: 0\n" "$cfg"
                
                if grep -q "hosts-google" "$file"; then
                    google_warn="${RED_BRIGHT}ВНИМАНИЕ: в /etc/config/zapret включен hosts-google!${CLR_OFF}"
                fi
            fi
        fi
    fi
done

if [ -n "$google_warn" ]; then
    echo "--------------------------------------------------------------"
    printf "%b\n" "$google_warn"
fi

echo ""
echo "=============================================================="
echo "   СТАТУС СЛУЖБ"
echo "=============================================================="
echo "СЕРВИС          | СОСТОЯНИЕ      | АВТОЗАПУСК"
echo "--------------------------------------------------------------"

for s in zeroblock youtubeUnblock zapret ruantiblock podkop; do
    if [ -f "/etc/init.d/$s" ]; then
        if /etc/init.d/$s status 2>/dev/null | grep -q "running"; then
            st_txt="▶ РАБОТАЕТ"
            st_clr="${GREEN}"
        else
            st_txt="■ ОСТАНОВЛЕН"
            st_clr="${RED_BRIGHT}"
        fi
        
        if /etc/init.d/$s enabled 2>/dev/null; then
            au_txt="РАЗРЕШЕН"
            au_clr="${GREEN}"
        else
            au_txt="ЗАПРЕЩЕН"
            au_clr="${RED_BRIGHT}"
        fi

        printf "%-15s | " "$s"
        printf "%b%s${CLR_OFF}" "$st_clr" "$st_txt"
        
        case "$st_txt" in
            "▶ РАБОТАЕТ")   printf "     | " ;;
            "■ ОСТАНОВЛЕН") printf "   | " ;;
        esac

        printf "%b%s${CLR_OFF}\n" "$au_clr" "$au_txt"
    fi
done

echo "--------------------------------------------------------------"
printf "CPU LOAD (1 min): %-4s | RAM: %s%% | AWG10: %b\n" "$LOAD" "$MEM_PCT" "$PING_RES"
echo "=============================================================="
