#!/bin/sh
# analyzer.sh

LOG_FILE="/root/analyzer.log"
TMP_OUT="/tmp/analyzer.raw"

CLR_OFF="\033[0m"; RED_BRIGHT="\033[1;31m"; GREEN="\033[0;32m"; YELLOW="\033[0;33m"
IFACE="awg10"
clear
# --- ПРОВЕРКА И УСТАНОВКА WGET-SSL ---
if ! opkg list-installed | grep -q "wget-ssl"; then
    echo "Утилита wget-ssl не найдена. Попытка установки..."
    if ! opkg install wget-ssl; then
        echo "Прямая установка не удалась. Обновление списков пакетов..."
        opkg update
        if ! opkg install wget-ssl; then
            echo -e "${RED_BRIGHT}ОШИБКА: Не удалось установить wget-ssl.${CLR_OFF}"
            echo -e "${YELLOW}ВНИМАНИЕ: Часть данных (тесты через интерфейс) будет некорректна.${CLR_OFF}"
            echo "Нажмите Enter, чтобы продолжить..."
            read _
        fi
    fi
fi


{
echo ""
# 0. Сбор данных
LOAD=$(uptime | awk -F'load average:' '{ print $2 }' | cut -d, -f1 | sed 's/ //g')
MEM_T=$(free | grep Mem | awk '{print $2}'); MEM_U=$(free | grep Mem | awk '{print $3}')
MEM_P=$((MEM_U * 100 / MEM_T))
LAN_IP=$(ip addr show br-lan 2>/dev/null | grep -w inet | awk '{print $2}' | cut -d/ -f1)
[ -z "$LAN_IP" ] && LAN_IP=$(uci -q get network.lan.ipaddr)
NAND_PART=$(df | grep -q "/overlay" && echo "/overlay" || echo "/"); NAND_PCT=$(df -h "$NAND_PART" | awk 'NR==2 {print $5}'); NAND_FREE=$(df -h "$NAND_PART" | awk 'NR==2 {print $4}')


# --- БЛОК 1: СТАТУС СЛУЖБ ---
echo "== СТАТУС СЛУЖБ (НЕ УСТАНОВЛЕННЫЕ НЕ ОТОБРАЖАЮТСЯ)"
echo "=============================================================="
INSTALLED_SERVICES=""

# 1. Сбор статуса только для zeroblock (основа стабильности)
ZB_RUN=0
zeroblock status 2>/dev/null | grep -q "Overall: RUNNING" && ZB_RUN=1

for s in zeroblock youtubeUnblock zapret ruantiblock podkop sing-box; do
    if [ -f "/etc/init.d/$s" ]; then
        INSTALLED_SERVICES="$INSTALLED_SERVICES $s"
        
        # Сброс цветов перед каждой итерацией
        ST_CLR="${RED_BRIGHT}"; S_NAME_CLR=""; BLUE="\033[0;34m"

        # 2. Определение текста статуса
        if [ "$s" = "podkop" ]; then
            ST_OUT="UNDEFINED"
            ST_CLR="${BLUE}"
        elif [ "$s" = "zeroblock" ]; then
            [ $ZB_RUN -eq 1 ] && { ST_OUT="RUNNING"; ST_CLR="${GREEN}"; } || ST_OUT="STOPPED"
        elif [ "$s" = "sing-box" ]; then
            if /etc/init.d/sing-box status 2>/dev/null | grep -q "running"; then
                ST_OUT="RUNNING (MANAGED BY ZB)"
                ST_CLR="${GREEN}"
            else
                ST_OUT="STOPPED"
            fi
        else
            # Для остальных стандартный grep
            if /etc/init.d/$s status 2>/dev/null | grep -q "running"; then
                ST_OUT="RUNNING"
                ST_CLR="${GREEN}"
            else
                ST_OUT="STOPPED"
            fi
        fi

        ST_OUT=$(echo "$ST_OUT" | tr 'a-z' 'A-Z')

        /etc/init.d/$s enabled 2>/dev/null && { au_txt="РАЗРЕШЁН"; au_clr="${GREEN}"; } || { au_txt="ОТКЛ"; au_clr="${RED_BRIGHT}"; }
        
        printf "  %b%-15s${CLR_OFF} | ${ST_CLR}%-25s${CLR_OFF} | ${au_clr}${au_txt}${CLR_OFF}\n" "$S_NAME_CLR" "$s" "$ST_OUT"
    fi
done

# --- БЛОК 2: ПРОВЕРКА КОНФЛИКТОВ ZEROBLOCK ---
if echo "$INSTALLED_SERVICES" | grep -q "zeroblock"; then
    echo ""
    echo "== ПРОВЕРКА КОНФЛИКТОВ ZEROBLOCK"
    echo "=============================================================="
    tmp_list="/tmp/zb_lists.tmp"; > "$tmp_list"
    sections=$(uci -q show zeroblock | grep "=section" | cut -d. -f2 | cut -d= -f1)
    for sid in $sections; do
        s_name=$(uci -q get zeroblock."$sid".name); [ -z "$s_name" ] && s_name="$sid"
        lists=$(uci -q get zeroblock."$sid".community_lists | sed "s/'//g")
        for l in $lists; do echo "$l|$s_name" >> "$tmp_list"; done
    done
    all_unique_lists=$(cut -d'|' -f1 "$tmp_list" 2>/dev/null | sort | uniq -d)
    if [ -z "$all_unique_lists" ]; then
        echo "  Дубликаты списков не обнаружены. [${GREEN}✔${CLR_OFF}]"
    else
        for d in $all_unique_lists; do
            found_in=$(grep "^$d|" "$tmp_list" | cut -d'|' -f2 | tr '\n' ' ' | sed 's/ $//' | sed 's/ /, /g')
            printf "  ${RED_BRIGHT}КОНФЛИКТ:${CLR_OFF} список ${YELLOW}'%s'${CLR_OFF} найден в: ${YELLOW}%s${CLR_OFF}\n" "$d" "$found_in"
        done
    fi
    grep -Ei "russia_inside|russia_outside" "$tmp_list" 2>/dev/null | while read -r line; do
         # Добавлено 4 пробела после ИНФО для выравнивания с КОНФЛИКТ
         printf "  ${YELLOW}ИНФО:    ${CLR_OFF} найден список ${GREEN}%s${CLR_OFF} в секции: ${YELLOW}%s${CLR_OFF}\n" "$(echo "$line" | cut -d'|' -f1)" "$(echo "$line" | cut -d'|' -f2)"
    done
    rm -f "$tmp_list"
fi

# --- БЛОК 3: АНАЛИЗ КОНФИГУРАЦИЙ ---
echo ""
echo "== АНАЛИЗ КОНФИГУРАЦИЙ (ИЩЕМ YOUTUBE + GOOGLEVIDEO)"
echo "=============================================================="
for cfg in zeroblock podkop zapret youtubeUnblock; do
    echo "$INSTALLED_SERVICES" | grep -q "$cfg" || continue
    
    if [ "$cfg" = "zapret" ]; then
        zap_count=0
        LISTS_PATHS=$(grep -oE "\-\-hostlist=[^ '\" ]+" /etc/config/zapret | cut -d= -f2 | sed "s/['\"]//g" | sort | uniq)
        for f_path in $LISTS_PATHS; do
            if [ -f "$f_path" ]; then
                match_c=$(grep -Ei "youtube|googlevideo\.com" "$f_path" | wc -l)
                if [ "$match_c" -gt 0 ]; then
                    zap_count=$((zap_count + 1))
                    exact=$(grep -Ei "^(youtube\.com|googlevideo\.com)$" "$f_path" | wc -l)
                    subs=$((match_c - exact))
                    printf "  %-15s найден в: ${YELLOW}%-25s${CLR_OFF}\n" "$cfg" "$(basename "$f_path")"
                    printf "                  └─ Основные домены:  ${GREEN}%d${CLR_OFF}\n" "$exact"
                    printf "                  └─ Субдомены/прочее: ${GREEN}%d${CLR_OFF}\n" "$subs"
                fi
            fi
        done
        [ "$zap_count" -eq 0 ] && printf "  %-15s ютуб найден: 0\n" "$cfg"

    else
        # Для zeroblock, podkop и youtubeUnblock
        any_found=0
        # Получаем список всех секций типа 'section'
        sections=$(uci -q show "$cfg" | grep "=section" | cut -d. -f2 | cut -d= -f1)
        
        for s in $sections; do
            # Проверяем включена ли секция (в подкопе секция main обычно активна по умолчанию)
            # Если параметра enabled нет, считаем секцию активной (как в podkop)
            IS_EN=$(uci -q get "$cfg.$s.enabled")
            [ "$IS_EN" = "0" ] && continue
            
            # Берем весь вывод uci show для этой секции
            # Это подцепит и user_domains_text, и community_lists
            SECTION_DATA=$(uci -q show "$cfg.$s")
            count=$(echo "$SECTION_DATA" | grep -Ei "youtube|googlevideo\.com|russia_inside|russia_outside" | wc -l)
            
            if [ "$count" -gt 0 ]; then
                any_found=1
                printf "  %-15s найден в: ${YELLOW}%-25s${CLR_OFF} (%d)\n" "$cfg" "$s" "$count"
            fi
        done
        [ "$any_found" -eq 0 ] && printf "  %-15s ютуб найден: 0\n" "$cfg"
    fi
done


# --- БЛОК 4: ПРОВЕРКА ДОСТУПОВ (YOUTUBE.COM) ---
echo ""
echo "== ПРОВЕРКА ДОСТУПОВ (YOUTUBE.COM)"
echo "=============================================================="

# 1. Тест через Sing-box (Opera)
SB_CONF="/etc/sing-box/config.json"
if [ -f "$SB_CONF" ]; then
    # Ищем Opera в outbounds (как в твоем конфиге)
    DYNAMIC_PORT=$(jq -r '.outbounds[] | select(.tag=="Opera") | .server_port' "$SB_CONF" 2>/dev/null)
    
    if [ -n "$DYNAMIC_PORT" ] && [ "$DYNAMIC_PORT" != "null" ]; then
        PROXY_ADDR="127.0.0.1:$DYNAMIC_PORT"
        # Для прокси оставляем curl, он тут обычно справляется
        P_CODE=$(curl -I -s --connect-timeout 3 -x http://$PROXY_ADDR https://youtube.com | head -n 1 | tr -d '\r\n')
        if [ -n "$P_CODE" ]; then
            printf "  OPERA (Proxy): %b (%s)\n" "${GREEN}ОНЛАЙН${CLR_OFF}" "$P_CODE"
        else
            printf "  OPERA (Proxy): %b\n" "${RED_BRIGHT}ОФЛАЙН${CLR_OFF}"
        fi
    else
        printf "  OPERA (Proxy): ${YELLOW}ПОРТ НЕ НАЙДЕН В OUTBOUNDS${CLR_OFF}\n"
    fi
fi

# 2. Тест через интерфейс AWG10 (используем wget-ssl)
if [ -d "/sys/class/net/$IFACE" ]; then
    IF_IP=$(ip addr show "$IFACE" 2>/dev/null | grep -w inet | awk '{print $2}' | cut -d/ -f1)
    
    if [ -n "$IF_IP" ]; then
        # Нам важен сам факт ответа (даже 429 Too Many Requests), поэтому проверяем наличие HTTP в выводе
        W_OUT=$(wget --spider --server-response --no-check-certificate -4 --timeout=4 --tries=1 --bind-address="$IF_IP" https://youtube.com 2>&1)
        W_CODE=$(echo "$W_OUT" | grep "HTTP/" | awk '{print $2, $3}' | head -n 1)

        if [ -n "$W_CODE" ]; then
            # Если есть хоть какой-то HTTP код — туннель живой
            printf "  %-14s %b (%s)\n" "$IFACE:" "${GREEN}ОНЛАЙН${CLR_OFF}" "$W_CODE"
        else
            W_ERR=$(echo "$W_OUT" | grep -Ei "failed|error|timeout|refused" | tail -n 1 | sed 's/^ *//')
            [ -z "$W_ERR" ] && W_ERR="No response"
            printf "  %-14s %b (ПРИЧИНА: %s)\n" "$IFACE:" "${RED_BRIGHT}ОФЛАЙН${CLR_OFF}" "$W_ERR"
        fi
    else
        printf "  %-14s %b (НЕТ IP АДРЕСА)\n" "$IFACE:" "${RED_BRIGHT}ОШИБКА${CLR_OFF}"
    fi
fi

# --- ДЕТАЛИ ИНТЕРФЕЙСА ОСТАЮТСЯ БЕЗ ИЗМЕНЕНИЙ ---

# Блок деталей интерфейса (трафик и пинг)
if [ -d "/sys/class/net/$IFACE" ]; then
    echo ""
    echo "== ИНТЕРФЕЙС $IFACE (ДЕТАЛИ)"
    echo "=============================================================="
    [ -n "$(ip link show $IFACE | grep 'UP')" ] && IF_STATUS="${GREEN}UP (ON)${CLR_OFF}" || IF_STATUS="${RED_BRIGHT}DOWN (OFF)${CLR_OFF}"
    printf "  Статус:      %b\n" "$IF_STATUS"
    RX_B=$(cat /sys/class/net/$IFACE/statistics/rx_bytes); TX_B=$(cat /sys/class/net/$IFACE/statistics/tx_bytes)
    printf "  Получено:    %.2f MB\n" "$(echo $RX_B | awk '{print $1/1048576}')"
    printf "  Отправлено:  %.2f MB\n" "$(echo $TX_B | awk '{print $1/1048576}')"
    printf "  Пинг (ya.ru via $IFACE): "
    P_D=$(ping -I $IFACE -c 4 ya.ru 2>/dev/null)
    if [ $? -eq 0 ]; then
        STATS=$(echo "$P_D" | grep "round-trip" | sed 's/[=/]/ /g' | awk '{printf "%.1f/%.1f ms", $(NF-3), $(NF-1)}')
        LOSS=$(echo "$P_D" | grep -o "[0-9]*% packet loss" | awk '{print $1}' | tr 'a-z' 'A-Z')
        L_CLR="${GREEN}"; [ "$(echo "$LOSS" | tr -d '%')" -gt 0 ] && L_CLR="${YELLOW}"
        printf "${L_CLR}%s (%s LOSS)${CLR_OFF}\n" "$STATS" "$LOSS"
    else
        printf "${RED_BRIGHT}ERROR (100%% LOSS)${CLR_OFF}\n"
    fi
fi


echo ""
echo "== ПРОВЕРКА DNS"
echo "=============================================================="
NS_L=$(nslookup facebook.com 2>/dev/null); DNS_SRV=$(echo "$NS_L" | grep "Server:" | awk '{print $2}'); FB_IP=$(echo "$NS_L" | grep "Address" | tail -n 1 | awk '{print $NF}' | cut -d: -f1)
DNS_FWD=$(uci -q get dhcp.@dnsmasq[0].server | awk '{print $1}' | sed "s/'//g"); DNS_R_ST="${GREEN}${DNS_FWD}${CLR_OFF}"; [ -z "$DNS_FWD" ] && DNS_R_ST="${RED_BRIGHT}NOT FOUND${CLR_OFF}"
printf "  DNS Server:  %s\n" " ${DNS_SRV}:53"; printf "  DNS Redirect: %b\n" "$DNS_R_ST"
RES="${YELLOW}${FB_IP}${CLR_OFF}"; [ -z "$FB_IP" ] && RES="${RED_BRIGHT} FAILED${CLR_OFF}"
printf "  Facebook IP: %b\n" " $RES"

echo ""
echo "== СИСТЕМНЫЕ РЕСУРСЫ"
echo "=============================================================="
printf "  LAN IP: %s\n" "$LAN_IP"
printf "  CPU: %s | RAM: %s%% | NAND: %s/%s\n" "$LOAD" "$MEM_P" "$NAND_PCT занято" "$NAND_FREE доступно"
echo "=============================================================="
} | tee "$TMP_OUT"

sed 's/\x1b\[[0-9;]*m//g' "$TMP_OUT" > "$LOG_FILE"
rm "$TMP_OUT"
printf "  ${YELLOW}ПУТЬ К ЛОГУ: %s${CLR_OFF}\n\n" "$LOG_FILE"
