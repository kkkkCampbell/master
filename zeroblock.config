
config settings 'settings'
	option log_level 'warn'
	option show_trace_logs '0'
	option health_enabled '1'
	option health_interval '600'
	option health_dns_check '1'
	option health_clash_api_check '1'
	option health_ping_ip '77.88.8.8 8.8.8.8'
	option health_opera_host 'ya.ru google.com'
	option update_interval '1d'
	option timeout_dnsmasq_restart '150'
	option timeout_xray_check '60'
	option disable_startup_check '0'
	option manage_xray '0'
	option update_time '09:00'
	option api 'v2'
	option enable_bad_interface_monitoring '0'
	option download_lists_via_proxy '0'
	option auto_fallback_two_stage '1'
	option whitelist_probe_max '100'
	option lists_failure_mode 'degrade'
	option timeout_singbox_check '60'
	option timeout_singbox_kill '15'
	option health_dns_server_check '0'
	option health_dns_test_host 'ya.ru'
	option dns_query_timeout '15'
	option singbox_double_check '0'
	option singbox_double_check_delay '15'
	option lists_tls_insecure '0'
	option opera_proxy_enabled '1'
	option timeouts_forced_to_max_v4 '1'
	option text_lists_migrated '1'
	option sub_max_proxies_capped '1'
	option schema_version '55'
	option autoremove_static_lease_default_v1 '1'
	option subscription_ua_migrated_v2 '1'
	option subscription_update_interval 'off'
	option whitelist_bootstrap_max_attempts '10'
	option health_opera '1'
	option whitelist_bootstrap_dns_server '77.88.8.8'
	option whitelist_bootstrap_dns_via_whitelist '0'
	option dns_recovery_enabled '1'
	option dns_recovery_mode 'temporary'
	option dns_recovery_main_candidates_enabled '0'
	option dns_recovery_bootstrap_candidates_enabled '0'
	option wait_for_default_route '0'
	option health_clash_api_timeout '5'
	option health_generate204_timeout '3'
	option subscription_via_yandex_translate '0'
	option auto_fallback_source 'url'
	option whitelist_bootstrap_dns_type 'udp'
	option timeout_dns_bootstrap_probe_start '5'
	option timeout_dns_bootstrap_probe_stop '1'
	option show_soft_matrix_editor '0'
	option soft_decision_matrix_enabled '0'
	option soft_routing_matrix_enabled '0'
	option show_custom_config_editor '0'
	option dns_benchmark_parallelism '8'
	option log_config_proxies '1'
	option log_disable_fakeip '1'
	option log_proxy_orchestrator '1'
	option log_subscription_parser '1'
	option log_xray_generator '1'
	option memory_instrumentation '0'
	option tailscale_rescue_fail_threshold '2'
	option tailscale_rescue_recover_threshold '5'
	option tailscale_rescue_require_control_url '0'
	option tailscale_rescue_direct_url 'https://rc.routerich.ru'
	option tailscale_rescue_control_url 'https://controlplane.tailscale.com'

