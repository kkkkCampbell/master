	# Ожидание завершения автонастройки zeroblock
	wait_zeroblock_ready() {
		local timeout=180  # 3 минуты
		local elapsed=0
		
		echo -n "→ Ожидание автонастройки zeroblock (макс. 3 минуты)"
		
		while [ $elapsed -lt $timeout ]; do
			if uci show zeroblock 2>/dev/null | grep -q "zeroblock.awg10=section" && \
			   uci show zeroblock 2>/dev/null | grep -q "zeroblock.opera=section"; then
				echo -e ""
				echo -e "✓ Автонастройка завершена (через ${elapsed} сек)"
				uci set zeroblock.auto_config.sections_auto_load='' 
				uci commit zeroblock
				uci commit luci
				return 0
			fi
			
			echo -n "."
			sleep 2
			elapsed=$((elapsed + 2))
		done
		
		echo -e ""
		echo -e "⚠ Таймаут: автонастройка не завершилась за 3 минуты"
		return 1
	}

	# Управление DNS (аргумент = IP DNS сервера, или recovery = восстановление)
	dns_redirect() {
		# если передан аргумент 'recovery' для восстановления DNS 
		if [ "$1" = "recovery" ] && [ "$NOBACKUP" = "" ]; then
			# Восстановление
			if [ -f /tmp/dhcp.bak ]; then
				cp /tmp/dhcp.bak /etc/config/dhcp
				rm /tmp/dhcp.bak
				/etc/init.d/dnsmasq restart >/dev/null 2>&1
				echo -e "✓ DNS конфиг восстановлен"
			fi
			
		elif echo -e "$1" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
			# Бэкап
			retval="$(uci get dhcp.@dnsmasq[0].server 2>/dev/null | tr -d '[:space:]')"
			if [ -n "$retval" ]; then
			  cp /etc/config/dhcp /tmp/dhcp.bak 2>/dev/null
			  NOBACKUP=""
			 else
			  echo -e "✗ Передан DNS ${1}. Архивация пропущена."
			  NOBACKUP="1"
			fi
			
			/etc/init.d/zeroblock stop >/dev/null 2>&1
			sleep 3
			
			# Замена SNS
			#uci set dhcp.@dnsmasq[0].server="$1"
			uci set dhcp.@dnsmasq[0].noresolv="1"
			uci -q del dhcp.@dnsmasq[0].server
			uci add_list dhcp.@dnsmasq[0].server="$1"
			sleep 1
			uci commit dhcp
			uci commit luci
			sleep 1
			/etc/init.d/dnsmasq restart >/dev/null 2>&1
			if [ "$(uci get dhcp.@dnsmasq[0].server)" = "$1" ]; then 
				echo -e "✓ DNS переключен на $1"
			fi
		fi
	}

