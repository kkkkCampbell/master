# Ожидание завершения автонастройки zeroblock
wait_zeroblock_ready() {
    local timeout=180  # 3 минуты
    local elapsed=0
    
    echo -n "→ Ожидание автонастройки zeroblock (макс. 3 минуты)"
    
    while [ $elapsed -lt $timeout ]; do
        if uci show zeroblock 2>/dev/null | grep -q "zeroblock.awg10=section" && \
           uci show zeroblock 2>/dev/null | grep -q "zeroblock.opera=section"; then
            echo ""
            echo "✓ Автонастройка завершена (через ${elapsed} сек)"
			uci set zeroblock.auto_config.sections_auto_load='' 
			uci commit zeroblock
			uci commit luci
            return 0
        fi
        
        echo -n "."
        sleep 2
        elapsed=$((elapsed + 2))
    done
    
    echo ""
    echo "⚠ Таймаут: автонастройка не завершилась за 3 минуты"
    return 1
}

# Управление DNS (аргумент = IP DNS сервера, или recovery = восстановление)
dns_redirect() {
    if [ "$1" = "recovery" ]; then
        # Восстановление
        if [ -f /tmp/dhcp.bak ]; then
            cp /tmp/dhcp.bak /etc/config/dhcp
            rm /tmp/dhcp.bak
            /etc/init.d/dnsmasq restart >/dev/null 2>&1
            echo "✓ DNS конфиг восстановлен"
        fi
    elif echo "$1" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        # Бэкап и замена
        cp /etc/config/dhcp /tmp/dhcp.bak 2>/dev/null
        uci set dhcp.@dnsmasq[0].server="$1"
        uci commit dhcp
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
        echo "✓ DNS переключен на $1"
    else
        echo "✗ Ошибка: аргумент должен быть IP адресом или recovery"
        return 1
    fi
}

# Обновление меню LuCI после установки пакетов
refresh_luci() {
    echo "→ Обновление меню LuCI..."
	
	# Перезапуск rpcd (отвечает за API и меню)
	/etc/init.d/rpcd reload

	# Перезапуск uhttpd (веб-сервер)
	/etc/init.d/uhttpd reload
	
    rm -rf /tmp/luci-modulecache/ 2>/dev/null
    rm -f /tmp/luci-indexcache.json 2>/dev/null
    /etc/init.d/rpcd reload >/dev/null 2>&1
    /etc/init.d/uhttpd reload >/dev/null 2>&1
    echo -e  "${YELLOW}При отсутствии ZeroBlock в меню \"Службы\" - обновите страницу.
Если обновление не помогло - перелогиньтесь.${CLR_OFF}"
}


# --- МЕНЮ ---

draw_main_menu() {
    clear
    echo -e "${CYAN}=================================${CLR_OFF}"
    echo -e "${CYAN}     ZEROBLOCK MANAGER $VER${CLR_OFF}"
    echo -e "${CYAN}=================================${CLR_OFF}"
    echo -e ""
    echo -e "  ${GREEN}1${CLR_OFF} — Установить и настроить ZeroBlock"
    
    BACKUP_COUNT=$(ls "$BACKUP_DIR"/*.tar.gz 2>/dev/null | wc -l)
    if [ "$BACKUP_COUNT" -gt 0 ]; then
        echo -e "  ${GREEN}2${CLR_OFF} — Восстановить настройки из бэкапа"
    else
        echo -e "  ${YELLOW}2${CLR_OFF} — Восстановить настройки из бэкапа ${YELLOW}[бэкапы отсутствуют]${CLR_OFF}"
    fi
    
    echo -e "  ${RED_BRIGHT}0${CLR_OFF} — Выход"
    echo -e ""
    echo -e -n "${CYAN}Введите номер пункта: ${CLR_OFF}"
    
    read input
    case "$input" in
        1)  echo -e ""
            echo -e "${GREEN}→ Запуск установки и настройки...${CLR_OFF}"
            break
            ;;
        2) if [ "$BACKUP_COUNT" -gt 0 ]; then
                echo -e ""; echo -e "${GREEN}→ Запуск восстановления...${CLR_OFF}"; restore_menu
            else menu; fi; ;;
        0) echo -e ""; echo -e "${GREEN}→ Выход${CLR_OFF}"; echo -e ""; exit 0; ;;
        *) draw_main_menu; ;;
    esac
}

restore_menu() {
    # Формируем список бэкапов в одну строку через |
    BACKUP_LIST=""
    TOTAL=0
    for f in $(ls -1 "$BACKUP_DIR"/*.tar.gz 2>/dev/null | sort -r); do
        [ -z "$BACKUP_LIST" ] && BACKUP_LIST="$f" || BACKUP_LIST="$BACKUP_LIST|$f"
        TOTAL=$((TOTAL + 1))
    done

    while true; do
        clear
        printf "%b\n" "${CYAN}=================================${CLR_OFF}"
        printf "%b\n" "${CYAN}       ВЫБОР БЭКАПА${CLR_OFF}"
        printf "%b\n" "${CYAN}=================================${CLR_OFF}"
        printf "%b\n" ""

        if [ $TOTAL -eq 0 ]; then
            printf "%b\n" "  ${YELLOW}Нет доступных бэкапов${CLR_OFF}"
            printf "%b\n" ""
            printf "%b0%b — Возврат\n" "${GREEN}" "${CLR_OFF}"
            printf "%b\n" ""
            printf "%bВведите номер: %b" "${CYAN}" "${CLR_OFF}"
            read choice
            [ "$choice" = "0" ] && menu
            continue
        fi

        # Выводим список
        NUM=1
        SAVED_IFS="$IFS"
        IFS='|'
        for b in $BACKUP_LIST; do
            NAME=$(basename "$b" .tar.gz)
            printf "%b%s%b — %s\n" "${GREEN}" "$NUM" "${CLR_OFF}" "$NAME"
            NUM=$((NUM + 1))
        done
        IFS="$SAVED_IFS"

        printf "%b\n" ""
        printf "%b0%b — Возврат в главное меню\n" "${GREEN}" "${CLR_OFF}"
        printf "%b1111%b — Удалить все бэкапы, кроме первого и последнего\n" "${RED_BRIGHT}" "${CLR_OFF}"
        printf "%b\n" ""
        printf "%bВведите номер: %b" "${CYAN}" "${CLR_OFF}"
        read choice

        # Выход
        [ "$choice" = "0" ] && draw_main_menu && return

        # Удаление старых
		if [ "$choice" = "1111" ]; then
			echo -e "${RED_BRIGHT}ВЫ УВЕРЕНЫ? (y/n)${CLR_OFF}"
			read absolutly
			if [ "$absolutly" != "y" ]; then 
				restore_menu
			fi

			if [ $TOTAL -gt 2 ]; then
				TMP_DIR="/tmp/backup_tmp_$$"
				mkdir -p "$TMP_DIR"
				
				NUM=1
				SAVED_IFS="$IFS"
				IFS='|'
				for b in $BACKUP_LIST; do
					if [ $NUM -eq 1 ] || [ $NUM -eq $TOTAL ]; then
						cp "$b" "$TMP_DIR/"
					fi
					NUM=$((NUM + 1))
				done
				IFS="$SAVED_IFS"
				
				# Удаляем всё
				rm -rf "$BACKUP_DIR"/*
				
				# Возвращаем два файла
				cp "$TMP_DIR"/* "$BACKUP_DIR/"
				rm -rf "$TMP_DIR"
				
				# Пересобираем BACKUP_LIST
				BACKUP_LIST=""
				TOTAL=0
				for f in $(ls -1 "$BACKUP_DIR"/*.tar.gz 2>/dev/null | sort -r); do
					[ -z "$BACKUP_LIST" ] && BACKUP_LIST="$f" || BACKUP_LIST="$BACKUP_LIST|$f"
					TOTAL=$((TOTAL + 1))
				done
				
				printf "%b✓ Оставлены первый и последний бэкап (%d шт)%b\n" "${GREEN}" "$TOTAL" "${CLR_OFF}"
				sleep 1
			else
				printf "%b⚠ Нечего удалять (бэкапов 2 или меньше)%b\n" "${YELLOW}" "${CLR_OFF}"
				sleep 1
			fi
			continue
		fi

        # Проверка, что введено число в диапазоне
        if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le $TOTAL ]; then
            SELECTED=$(echo "$BACKUP_LIST" | cut -d'|' -f"$choice")
            NAME=$(basename "$SELECTED" .tar.gz)
            printf "%b\n"
            printf "%bВосстановить из бэкапа %s? (y/n): %b" "${YELLOW}" "$NAME" "${CLR_OFF}"
            read confirm
            if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                printf "%b\n→ Восстановление...%b\n" "${CYAN}" "${CLR_OFF}"
                sysupgrade -r "$SELECTED"
                if [ $? -eq 0 ]; then
                    printf "%b✓ Бэкап восстановлен%b\n" "${GREEN}" "${CLR_OFF}"
                    printf "%b⚠ Требуется перезагрузка роутера%b\n" "${YELLOW}" "${CLR_OFF}"
                else
                    printf "%b✗ Ошибка восстановления%b\n" "${RED_BRIGHT}" "${CLR_OFF}"
                fi
                printf "%b\nПерезагрузить роутер? (${RED_BRIGHT}y${CLR_OFF}/${GREEN}n${CLR_OFF}): %b" "${CYAN}" "${CLR_OFF}"
                read reboot
				[ "$reboot" = "y" ] || [ "$reboot" = "Y" ] && echo "РОУТЕР ПЕРЕЗАГРУЖАЕТСЯ" && /sbin/reboot && exit
                restore_menu
                return
            fi
        fi
    done
}

# ============================================
# MAIN
# ============================================


draw_main_menu




create_backup_dir
create_backup
verify_backup "${BACKUP_FILE}"
kill_podkop
dns_redirect "${TEMP_DNS}"
install_zeroblock
stop_and_rplce_config_zeroblock
wait_zeroblock_ready
dns_redirect "recovery"
refresh_luci

echo ""
echo -e  " ===${RED_BRIGHT} РОУТЕР БУДЕТ ПЕРЕЗАГРУЖЕН ЧЕРЕЗ 10 СЕКУНД! ${CLR_OFF}=== "
sleep 10 && /sbin/reboot
echo ""
