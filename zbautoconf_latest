#!/bin/sh
# zbautoconf.sh

# ============================================
# ZEROBLOCK AUTOSETUP SCRIPT - PART 0
# Backup system configuration using native sysupgrade
# ============================================

BACKUP_DIR="/root/zeroblock_autosetup/sysbackup"
TEMP_DNS="9.9.9.11"
VER="0.0.1"
echo "ver $VER"
sleep 3
clear

# --- ЦВЕТА ---
if [ -t 1 ]; then
	CLR_OFF="\033[0m"; RED_BRIGHT="\033[1;31m"; GREEN="\033[0;32m"; YELLOW="\033[0;33m"; BLUE="\033[0;34m"; CYAN="\033[0;36m"; BLACK="\033[30m"
fi

# Установка zeroblock с "защитой" от ТСПУ
install_zeroblock() {
    UPDATE_LOG="/tmp/opkg_update.log"
	rm -f /etc/config/zeroblock

    # -1) Проверка, установлен ли zeroblock
    if opkg list-installed 2>/dev/null | grep -q "^zeroblock -"; then
        echo "✓ zeroblock уже установлен"
        return 0
    fi
    
    # 2) opkg update в цикле 4 раза
    echo "→ opkg update (до 4 попыток)..."
    for i in 1 2 3 4; do
        printf "  Попытка $i/4...  "
        opkg update > "$UPDATE_LOG" 2>&1
        
        # 3) Анализ лога на ошибки
        if grep -qiE "failed|error|unable|not found|returned [1-9]|bad address|refused|timeout" "$UPDATE_LOG"; then
            echo "  ✗ Ошибки в попытке $i"
            [ $i -eq 4 ] && { echo "✗ Не удалось обновить репозитории"; return 1; }
            sleep 3
        else
            echo "  ✓ Репозитории обновлены (попытка $i)"
            break
        fi
    done
    
    # 5) Установка zeroblock
    echo "→ Установка zeroblock luci-app-zeroblock..."
    opkg install zeroblock luci-app-zeroblock > /tmp/opkg_install.log 2>&1
    
    # 6) Проверка установки
    if opkg list-installed 2>/dev/null | grep -q "^zeroblock -"; then
        echo "✓ zeroblock успешно установлен"
    else
        echo "✗ Ошибка: zeroblock не установился"
        cat /tmp/opkg_install.log
        return 1
    fi
}



# Функция создания директории
create_backup_dir() {
    if [ ! -d "$BACKUP_DIR" ]; then
        mkdir -p "$BACKUP_DIR"
        if [ $? -eq 0 ]; then
            echo "✓ Директория $BACKUP_DIR создана"
        else
            echo "✗ Ошибка: не могу создать $BACKUP_DIR"
            exit 1
        fi
    fi
}

# Функция создания штатного бэкапа через sysupgrade -b
create_backup() {
    DATE_TIME=$(date +%Y_%m_%d-%H_%M_%S)
    BACKUP_FILE="$BACKUP_DIR/${DATE_TIME}.tar.gz"
    
    echo "→ Создание штатного бэкапа через sysupgrade -b"
    echo "  Файл: $BACKUP_FILE"
    
    # Штатная команда OpenWRT для бэкапа конфигов
	printf "  "
    sysupgrade -b "$BACKUP_FILE"
    
    if [ $? -eq 0 ] && [ -f "$BACKUP_FILE" ]; then
        printf "%b" "  ${GREEN}✓ Бэкап успешно создан${CLR_OFF}"
        echo "  Размер: $(ls -lh "$BACKUP_FILE" | awk '{print $5}')"
    else
        printf "%b" "  ${RED_BRIGHT}✗ Ошибка: бэкап не создан${CLR_OFF}"
        exit 1
    fi
	echo ""
}


# ============================================
# Функция проверки бэкапа
# ============================================

verify_backup() {
    BACKUP_FILE="$1"
    
    echo "→ Проверка бэкапа: $BACKUP_FILE"
    
    # Проверка 1: существует ли файл
    if [ ! -f "$BACKUP_FILE" ]; then
        echo "✗ Ошибка: файл бэкапа не найден"
        return 1
    fi
    echo "  ✓ Файл существует"
    
    # Проверка 2: не нулевой ли размер
    if [ ! -s "$BACKUP_FILE" ]; then
        echo "✗ Ошибка: файл бэкапа пустой"
        return 1
    fi
    echo "  ✓ Размер не нулевой"
    
    # Проверка 3: валидный ли tar.gz
    if tar -tzf "$BACKUP_FILE" > /dev/null 2>&1; then
        echo "  ✓ Архив валидный (tar.gz)"
    else
        echo "✗ Ошибка: архив повреждён или не tar.gz"
        return 1
    fi
    
    # Проверка 4: количество файлов в архиве (для информации)
    FILE_COUNT=$(tar -tzf "$BACKUP_FILE" 2>/dev/null | wc -l)
    echo "  ✓ Архив содержит $FILE_COUNT файлов/директорий"
    
    # Проверка 5: наличие ключевых конфигов (контрольная)
    if tar -tzf "$BACKUP_FILE" 2>/dev/null | grep -q "etc/config/system"; then
        echo "  ✓ Найдены ключевые конфиги (etc/config/)"
    else
        echo "  ⚠ Внимание: etc/config/ не обнаружен (возможно, так и задумано)"
    fi
    
    echo -e  "  ${GREEN}✓ Бэкап прошёл проверку${CLR_OFF}"
    echo ""
    return 0
}

# BACKUP END

# Остановка и отключение podkop (если есть)
kill_podkop() {
    if [ -f /etc/init.d/podkop ]; then
        /etc/init.d/podkop stop 2>/dev/null
        /etc/init.d/podkop disable 2>/dev/null
        echo "✓ podkop остановлен и отключён"
    else
        echo "→ podkop не найден, пропускаем"
    fi
	echo ""
}

