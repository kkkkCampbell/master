#!/bin/sh

clear
echo
echo "==============================================="

# Определяем, какой пакетный менеджер используется
if [ -f /bin/apk ] || [ -f /sbin/apk ] || [ -f /usr/bin/apk ]; then
    echo "Using apk (OpenWrt 25+)"
    echo "==============================================="

    ROM_WORLD="/rom/etc/apk/world"
    if [ ! -f "$ROM_WORLD" ]; then
        echo "ERROR: Cannot find $ROM_WORLD"
        echo "Cannot determine which packages were added after installation."
        exit 1
    fi

    sort "$ROM_WORLD" > /tmp/rom_world.sorted

    while read -r pkg; do
        [ -z "$pkg" ] && continue
        if ! grep -qxF "$pkg" /tmp/rom_world.sorted; then
            echo "apk add $pkg"
        fi
    done < /etc/apk/world

    rm -f /tmp/rom_world.sorted

else
    echo "Using opkg (OpenWrt 24 and older)"
    echo "==============================================="

    # Оригинальный скрипт из первого сообщения
    DISTRI_TIME=$(awk '/Installed-Time/ {print $2}' /usr/lib/opkg/status | sort -n | head -n1)

    awk -v distri_time="$DISTRI_TIME" '
    BEGIN { RS = ""; FS = "\n" }
    {
        auto_installed = 0
        pkg_name = ""
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^Package: /) {
                pkg_name = substr($i, 10)
            } else if ($i ~ /^Auto-Installed: yes/) {
                auto_installed = 1
            } else if ($i ~ "^Installed-Time: " distri_time "$") {
                auto_installed = 1
            }
        }
        if (pkg_name != "" && !auto_installed) {
            if (pkg_name ~ /luci-i18n-/) {
                print "2 " pkg_name
            } else {
                print "1 " pkg_name
            }
        }
    }' /usr/lib/opkg/status | sort -k1,1n -k2 | cut -d' ' -f2- | while read pkg; do
        echo "opkg install $pkg"
    done
fi

echo "==============================================="
