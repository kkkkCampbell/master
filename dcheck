#!/bin/sh

INPUT_LOG="/tmp/url.log"
OUTPUT_LOG="/tmp/blocked.log"
TEMP_DOMAINS="/tmp/domains.tmp"

> "$TEMP_DOMAINS"
> "$OUTPUT_LOG"

[ ! -f "$INPUT_LOG" ] && { echo "Ошибка: файл $INPUT_LOG не найден"; exit 1; }

echo "Извлекаем домены второго уровня..."

# Извлечение доменов (как и раньше)
awk '{
    protocol = "https://"
    if (index($0, "(HTTP)")) {
        protocol = "http://"
    }
    
    pos = index($0, ")")
    if (pos > 0) {
        fqdn = substr($0, pos + 1)
        gsub(/^[ \t]+/, "", fqdn)
        print protocol "|" fqdn
    }
}' "$INPUT_LOG" | \
  while IFS="|" read -r proto fqdn; do
    clean_domain=$(echo "$fqdn" | sed 's/\/.*$//')
    
    sld=$(echo "$clean_domain" | awk -F. '{
        if (NF >= 2) {
            print $(NF-1)"."$(NF)
        }
    }')
    
    if [ -n "$sld" ]; then
        echo "$proto|$sld"
    fi
  done | \
  sort -u > "$TEMP_DOMAINS"

total=$(wc -l < "$TEMP_DOMAINS")
echo "Найдено доменов: $total"
echo "----------------------------------------"

checked=0
blocked=0

while IFS="|" read -r proto domain; do
    checked=$((checked + 1))
    url="${proto}${domain}"
    
    echo -n "[$checked/$total] $domain - "
    
    # ШАГ 1: Проверяем, существует ли домен вообще (не NXDOMAIN)
    if nslookup "$domain" >/dev/null 2>&1; then
        # Домен существует - проверяем доступность
        if curl -k -I -m 5 --fail --silent --output /dev/null "$url"; then
            echo "доступен"
        else
            echo "НЕДОСТУПЕН"
            echo "$domain" >> "$OUTPUT_LOG"
            blocked=$((blocked + 1))
        fi
    else
        # Проверяем, NXDOMAIN это или другая ошибка DNS
        if nslookup "$domain" 2>&1 | grep -qi "NXDOMAIN\|can't find"; then
            echo "NXDOMAIN (домен не существует) - пропускаем"
            # Не пишем в blocked.log
        else
            echo "DNS ошибка (возможно, временная) - пропускаем"
            # Не пишем в blocked.log - мало ли, резолвер временно тупит
        fi
    fi
done < "$TEMP_DOMAINS"

echo "----------------------------------------"
echo "Готово. Проверено: $total, недоступно: $blocked"

if [ -s "$OUTPUT_LOG" ]; then
    echo "Список недоступных доменов второго уровня:"
    cat "$OUTPUT_LOG"
else
    echo "Недоступных доменов не найдено."
fi

rm -f "$TEMP_DOMAINS"
