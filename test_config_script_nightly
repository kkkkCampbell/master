        printf "  !!!_${RED_BRIGHT}%s: \"Не создавать маршруты\" не установлен в 1${CLR_OFF}\n" \
            "$interface_id"
    fi
    # Проверка route_allowed_ips: ошибка, если значение равно "1"
    if [ ! -z "${rai_raw}" ] && echo ${rai_raw} | grep -q "_ips='1'"; then
        printf "  !!!_${RED_BRIGHT}%s: \"Маршрутизировать разрешённые IP-адреса\" включено. Catch-all интерфейс!${CLR_OFF}\n" \
            "$interface_id"
