    [ -n "$ZB_DNS" ] && printf "  %-4s%27s" "zeroblock" "DNS/Bootstrap DNS: " && \
	printf "%b%s${CLR_OFF}${CYAN}(${ZB_TYPE_DNS}) $ZB_DNS${dns_main_outbound}"
	[ -n "$ZB_B_DNS" ] && printf " / %b%s${CLR_OFF}\n" "${CYAN}" "$ZB_B_DNS${dns_bootstrap_outbound}"

