opkg list-installed | grep -q '^curl' && CURL_INSTALLED=1

# Получаем установленную версию opera-proxy (обрезаем суффикс типа -1, +build)
ver=$(opkg list-installed | awk '/^opera-proxy / {print $3}' | sed 's/[-+~].*//')

if [ "$ver" != "" ]; then 
	# Проверяем, что версия меньше и при этом не равна
	if opkg compare-versions "$ver" "<" "1.15.10" && ! opkg compare-versions "$ver" "=" "1.15.1"; then
		OPERA_INSTALLED=0
	fi
else
	echo "Пакет \"opera-proxy\" не установлен. Пропускаем обновление пакета."
fi

# Устанавливаем curl, wget и opera-proxy если их нет или версия OPERA устарела
if [ $WGET_INSTALLED -eq 0 ] || [ $CURL_INSTALLED -eq 0 ] || [ $OPERA_INSTALLED -eq 0 ]; then

    to_install=""   # начальное значение – пустая строка
    [ $WGET_INSTALLED -eq 0 ] && to_install="${to_install} wget-ssl"
    [ $CURL_INSTALLED -eq 0 ] && to_install="${to_install} curl"
    [ $OPERA_INSTALLED -eq 0 ] && to_install="${to_install} opera-proxy" && /etc/init.d/opera-proxy stop >/dev/null 2>&1
    # Убираем лишний пробел в начале (если была добавлена хоть одна программа)
    to_install="${to_install# }"

	echo -e "${GREEN}Устанавливаем/обновляем: $to_install${CLR_OFF}"

    while [ "$_i" -le "$_retries" ]; do
        echo -e "${YELLOW}Попытка обновления списка пакетов:${CLR_OFF} ($_i/$_retries)"

