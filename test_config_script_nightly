				[ $FIRST -eq 0 ] && printf "${CYAN},${CLR_OFF}"
				FIRST=0

				IS_CONFLICT=0; case " $CONFLICT_LISTS " in *" $item "*) IS_CONFLICT=1 ;; esac
				IS_WARN=0; for wl in $WARNING_LISTS; do [ "$item" = "$wl" ] && IS_WARN=1 && break; done

				if [ $IS_CONFLICT -eq 1 ]; then
					printf "!!!_${RED_BRIGHT}%s${CLR_OFF}" "$item"
				elif [ $IS_WARN -eq 1 ]; then
					printf "!_${YELLOW}%s${CLR_OFF}" "$item"
				else
					printf "${CYAN}%s${CLR_OFF}" "$item"
				fi
			done
			printf "\n"
		done
	done






	# --- БЛОК ПОИСКА СЕКЦИЙ РОДИТЕЛЬСКОГО КОНТРОЛЯ И СЕКЦИЙ БЛОКИРОВКИ ДОСТУПА В ZEROBLOCK---

	if [ "${ZB_AUTOSTART}" = "1" ]; then
		pkg="zeroblock"
		_block_sections=""
		_p_cont_sections=""
		SIDS=$(uci show "$pkg" 2>/dev/null | grep "=section$" | cut -d. -f2 | cut -d= -f1 | sort -u)
		for sid in $SIDS; do
			s_en=$(uci -q get "$pkg.$sid.enabled")
				if [ "$s_en" = "1" ]; then
					conn_type=$(uci -q get "$pkg.$sid.connection_type")
					p_cont=$(uci -q get "$pkg.$sid.parental_control")
					if [ "$conn_type" = "block" ] && [ "$p_cont" != "1" ]; then _block_sections="${_block_sections} $sid"; fi
					if [ "$p_cont" = "1" ]; then _p_cont_sections="${_p_cont_sections} $sid"; fi
				fi
		done
		
		[ -n "${_block_sections}" ] && \
		printf "  %-4s %30s" "${pkg}" "режим BLOCK:" && echo -e "${RED_BRIGHT}${_block_sections}${CLR_OFF}"
		[ -n "${_p_cont_sections}" ] && \
		printf "  %-4s %30s" "${pkg}" "режим Parental_control:" && echo -e "${YELLOW}${_p_cont_sections}${CLR_OFF}"
	fi





	# --- БЛОК ДОПОЛНИТЕЛЬНОЙ ИНФОРМАЦИИ (ПЕРЕСЕЧЕНИЯ) ---


	if [ $PK_INST -eq 1 ]; then
		# 1. Получаем DNS настройки
		PK_DNS=$(uci -q get "podkop.settings.dns_server")
		PK_B_DNS=$(uci -q get "podkop.settings.bootstrap_dns_server")

		# # 2. Получаем версию (вызываем напрямую)
		# PK_VER=$(podkop show_version 2>&1 /dev/null)

		# 2. Получаем версию подкопа
		PK_VER_RAW=$(podkop show_version 2>&1)
		PK_VER=""
		PK_OLD_FLAG=0

		# Проверка на "древность" по наличию start/stop в выводе
		if echo "$PK_VER_RAW" | grep -qE "start|stop"; then
			PK_OLD_FLAG=1
			# Попытка достать версию через opkg
			PK_VER=$(opkg list-installed podkop | awk '{print $3}')
		else
			PK_VER=$PK_VER_RAW
		fi

		# --- ПРОВЕРКА ВЕРСИЙ ПОДКОП ---

		# Очищаем версию: убираем 'v', отсекаем всё после дефиса, оставляем X.Y
		CLEAN_VER=$(echo "$PK_VER" | sed 's/^v//' | cut -d'-' -f1 | cut -d'.' -f1,2)

		# Логика определения цвета
		PK_COLOR=$GREEN  # По умолчанию зеленый
		if [ -n "$CLEAN_VER" ]; then
			# Передаем переменные внутрь awk через -v
			PK_STATUS=$(awk -v ver="$CLEAN_VER" -v obs="$PK_VER_OBSOLETE" -v min="$PK_VER_MIN" 'BEGIN {
				if (ver < obs) print "RED";
				else if (ver < min) print "YELLOW";
				else print "NORMAL";
			}')

			case "$PK_STATUS" in
				RED)    PK_COLOR=$RED_BRIGHT ;;
				YELLOW) PK_COLOR=$YELLOW ;;
			esac
		fi

		if [ $PK_AUTOSTART -eq 1 ]; then
			# Выводим DNS, только если там не пусто
			if [ -n "$PK_DNS" ] || [ -n "$PK_B_DNS" ]; then
				dns_type=""
				dns_type=$(uci -q get "podkop.settings.dns_type")
				#S[ -n "$PK_DNS" ] && printf "  podkop DNS/Bootstrap DNS: %b%s${CLR_OFF} " "${CYAN}" "(${dns_type}) ${PK_DNS}"
				#[ -n "$PK_B_DNS" ] && printf "/ %b%s${CLR_OFF}\n" "${CYAN}" "$PK_B_DNS"
			fi
			podkop global_check | grep -E '^❌|^⚠️' | grep -E "$p_check_include" | while IFS= read -r line; do
				case $line in
					"❌"*) printf "  podkop "; printf '\033[1;31m%s\033[0m\n' "$line" ;;
					"⚠️"*) printf "  podkop "; printf '\033[0;33m%s\033[0m\n' "$line" ;;
					*) printf '%s\n' "$line" ;;
				esac
			done
		fi
	fi


























	# Ищем пересечения внутри одной программы в юзерсписках доменов (списки, созданные самостоятельно)
	# ZeroBlock - отключенные секции не анализируются.
	[ $PK_AUTOSTART -eq 1 ] && check_userlists "podkop"
	[ ${ZB_AUTOSTART} -eq 1 ] && check_userlists "zeroblock"

	# Печатаем допданные в конце вывода блока (надо же как-то скрипт обновлять...)
	if [ $PK_AUTOSTART -eq 1 ]; then
		uci show podkop | grep -q "fully_routed_ips" && echo -e "  ${YELLOW}Полностью маршрутизированные IP-адреса включены!${CLR_OFF}"
		if [ -n "$PK_VER" ]; then
			printf "  Версия podkop: ${PK_COLOR}%s${CLR_OFF}\n" "$PK_VER"
		fi
	fi

	if [ ${ZB_AUTOSTART} -eq 1 ]; then
		_ZB_json="/tmp/zeroblock_status.json"
		# Ищем catch-all секции
		if [ -f "$_ZB_json" ]; then
			ZB_CATCH_ALL=$(grep -o '"\([^"]*\)":{"is_catch_all":true}' /tmp/zeroblock_status.json | cut -d'"' -f2)
			if [ -n "$ZB_CATCH_ALL" ]; then printf "  ${YELLOW}Секция в режиме catch-all: $ZB_CATCH_ALL${CLR_OFF}\n"; fi
		fi

		ZB_VER=$(zeroblock --version 2>/dev/null)
		
		# получаем zeroblock.cacholl.fully_routed_ips
		# выделяем .cacholl., то есть имя секции
		# запрашиваем uci -q get "zeroblock.cacholl.enabled" если ноль (секция неактивна), пропускаем, если не ноль, то выводим
		itog=""
		RAW=$(uci show zeroblock | grep "fully_routed_ips")
		# ищем ВКЛЮЧЕННЫЕ секции с полной маршрутизацией
		if [ -n "$RAW" ]; then
			for section in $RAW; do
				# Проверка условий
				fad=$(echo "$section" | cut -d'.' -f1,2)
				[ "$(uci -q get "$fad.enabled")" != "1" ] && continue
				addr=$(uci get "${fad}.fully_routed_ips")
				# Добавляем перевод строки между секциями, если itog не пуст
				if [ -n "$itog" ]; then
					itog="${itog}\n"
				fi
				itog="${itog}    Секция: $(echo "$section" | cut -d'.' -f2) = ${addr}"
			done
			if [ -n "$itog" ]; then
				printf "%b\n" "  ${YELLOW}Полностью маршрутизированные IP-адреса включены!"
				printf "%b" "${itog}${CLR_OFF}"
				echo ""
			fi
		fi

		if [ -n "$ZB_VER" ]; then
			ZB_VER=$(echo "$ZB_VER" | sed 's/^ZeroBlock v//')
			printf "  Версия zeroblock: ${PK_COLOR}%s${CLR_OFF}\n" "$ZB_VER"
		fi
	fi


	# --- ИЩЕМ ROUTE_ALLOWED_IPS И NOHOSTROUTE ---

	# region ИЩЕМ ROUTE_ALLOWED_IPS И NOHOSTROUTE

	# Поиск всех секций network с proto='amneziawg'
	uci show network | grep "\.proto='amneziawg'$" | while IFS= read -r line; do
		rai_raw=""
		# Извлечение полного идентификатора конфигурации (например, network.@interface[0])
		config_id="${line%%.proto=*}"
		# Удаление префикса "network." для получения имени/индекса интерфейса
		interface_id="${config_id#network.}"
		rai_raw=$(uci show | grep "amneziawg_${interface_id}" | grep route_allowed_ips)
		nohostroute=$(uci get "${config_id}.nohostroute" 2>/dev/null)
		# Проверка nohostroute: ошибка, если значение не равно "1"
		if [ -z "$nohostroute" ] || [ "$nohostroute" = "0" ]; then
			printf "  !!!_${RED_BRIGHT}%s: \"Не создавать маршруты\" не установлен в 1${CLR_OFF}\n" \
				"$interface_id"
		fi
		# Проверка route_allowed_ips: ошибка, если значение равно "1"
		if [ ! -z "${rai_raw}" ] && echo ${rai_raw} | grep -q "_ips='1'"; then
			printf "  !!!_${RED_BRIGHT}%s: \"Маршрутизировать разрешённые IP-адреса\" включено. Catch-all интерфейс!${CLR_OFF}\n" \
				"$interface_id"
		fi
	done
	# endregion




	# --- DNSMASQ SETTINGS CHECK ---


	indices=$(uci show dhcp 2>/dev/null | grep -o 'dhcp\.@dnsmasq\[[0-9]*\]' | sed 's/.*\[\([0-9]*\)\]/\1/' | sort -nu)
	count=$(echo "$indices" | wc -l)

	if [ -z "$indices" ] || [ "$count" -eq 0 ]; then
		printf "\033[1;31m  Секции dnsmasq не найдены\033[0m\n"
	fi

	if [ "$count" -gt 1 ]; then
		printf "${YELLOW}  Обнаружено несколько секций dnsmasq (%d). Невозможно определить используемую. ${CLR_OFF}" "$count"
	else
		idx="$indices"
		strict=$(uci -q get "dhcp.@dnsmasq[$idx].strictorder")
		noresolv=$(uci -q get "dhcp.@dnsmasq[$idx].noresolv")

		#if [ "$strict" = "1" ]; then
			# printf "%b\n" "${YELLOW}  Предупреждение: DNS и DHCP, Строгий порядок активен!${CLR_OFF}"
		#fi

		#if [ "$noresolv" != "1" ]; then
		#echo "$noresolv"
		#	printf "%b\n" "${RED_BRIGHT}  DNS и DHCP, Игнорировать файл resolv отключено! ${CLR_OFF}"
		#fi
	fi









	# ДОПОЛНИТЕЛЬНЫЕ ПРОВЕРКИ НА ОШИБКИ И НЕТОЧНОСТИ В НАСТРОЙКЕ ZeroBlock

	if [ "${ACTIVE_API}" == "zb" ]; then
		
		# проверка на состояние "Автозагрузка секций". Вкл|Выкл
		if [ ! -z $(uci -q get zeroblock.auto_config.sections_auto_load) ]; then
			echo -e "${YELLOW}  !_Автозагрузка секций включена${CLR_OFF}"
		fi
		
		# проверка на состояние "CIDR Списки сообщества". Вкл|Выкл
		[ ! -z "$(uci -q get zeroblock.settings.download_cidr)" ] && \
			echo -e "${YELLOW}  !_CIDR Списки сообщества: $(uci -q get zeroblock.settings.download_cidr)${CLR_OFF}"


		

	# --- БОЛЬШОЙ ЦИКЛ ПО ВСЕМ АКТИВНЫМ СЕКЦИЯМ ZB ---
	# внутри которого отдельными модулями выполняются некоторые операции с каждой секцией

		# ищем и выводим имена секций с активным индивидуальным DNS
		unw_dom_found=""
		unw_dom_sections=""	
		private_DNS=""
		for s in $ZB_SECTIONS_NAME; do
			dns_type=$(uci -q get "zeroblock.$s.dns_type")
			
			if [ -n "$dns_type" ]; then
				if [ -z "$private_DNS" ]; then
					private_DNS="$s"
				else
					private_DNS="$private_DNS, $s"
				fi
			fi

			# также собираем данные по нежелательным доменам в юзерсписках доменов
			raw_unw_domains=$(uci -q get "zeroblock.$s.user_domains_text")
			if [ -n "$raw_unw_domains" ]; then
				# фильтрация: удаляем каждый домен из EXCLUDE_FROM_UNWANTED (включая субдомены)
				filtered=""
				for item in $(echo "$raw_unw_domains" | tr ', \n' ' ' | tr -s ' '); do
					skip=0
					for ex in $EXCLUDE_FROM_UNWANTED; do
						case "$item" in
							"$ex" | *".$ex") skip=1; break ;;
						esac
					done
					[ $skip -eq 0 ] && filtered="${filtered:+$filtered }$item"
				done
				raw_unw_domains="$filtered"
				[ -z "$raw_unw_domains" ] && continue
				# оригинальный цикл по UNWANTED_DOMAINS без изменений
				for d in $UNWANTED_DOMAINS; do
					case "$EXCLUDE_FROM_UNWANTED " in *" $d "*) continue ;; esac
					case "$raw_unw_domains" in
						*"$d"*) 
							unw_dom_found="${unw_dom_found} $d,"
							unw_dom_sections="${unw_dom_sections} ${s},"
						;;
					esac
				done
			fi
		done
		# выводим секции с приватным ДНС
		[ -n "$private_DNS" ] && printf "  ${YELLOW}Секции с собственным DNS: ${private_DNS}${CLR_OFF}\n"
		unw_dom_sections="${unw_dom_sections# }"
		
		# выводим секции с нежелательными доменами
		# 1. Вычищаем мусор, дубли и склеиваем через запятую
		unw_dom_found=$(echo $unw_dom_found | tr ' ,' '\n' | sort -u | tr '\n' ',' | sed 's/,,*/,/g; s/^,//; s/,$//')
		unw_dom_sections=$(echo $unw_dom_sections | tr ' ,' '\n' | sort -u | tr '\n' ',' | sed 's/,,*/,/g; s/^,//; s/,$//')

		# 2. Магия: заменяем запятую на "запятая+пробел"
		unw_dom_found=$(echo "$unw_dom_found" | sed 's/,/, /g')
		unw_dom_sections=$(echo "$unw_dom_sections" | sed 's/,/, /g')

		[ -n "$unw_dom_sections" ] && unw_dom_found="${unw_dom_found% }" && printf "  %b%s\n" "${YELLOW}Домены [ $unw_dom_found ] в: ${CYAN}$unw_dom_sections${CLR_OFF}" && echo -e "  ${YELLOW}Убедитесь в том, что эти домены вам действительно нужны в юзердомен-списках.${CLR_OFF}"
	fi
fi









# --- БЛОК 7: СИСТЕМНЫЕ РЕСУРСЫ ---
sleep 4 # "успокоение" процессора
echo ""
echo "= СИСТЕМНЫЕ РЕСУРСЫ:"
printf "  LAN IP: %s\n" "${LAN_IP} | uptime: $(uptime | sed -E 's/^.*up ([^,]+),.*$/\1/') | (Прошивка: ${VERSION})"
printf "  CPU: %s | RAM: %s%% | NAND: %s занято / %s доступно\n" "$LOAD" "$MEM_P" "$NAND_PCT" "$NAND_FREE"
crontab -l | sed -e '/^[[:space:]]*#/d' -e 's/^/  /'
