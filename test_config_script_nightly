# --- БЛОК DNS ZEROBLOCK ---

dns_main_outbound=""
dns_bootstrap_outbound=""

if [ ${ZB_AUTOSTART} -eq 1 ] || [ $ZB_ERR -eq 1 ]; then
    ZB_DNS=$(uci -q get "zeroblock.settings.dns_server")
    ZB_B_DNS=$(uci -q get "zeroblock.settings.bootstrap_dns_server")
