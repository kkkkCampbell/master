uci show network | grep "\.proto='amneziawg'$" | while IFS= read -r line; do
    rai_raw=""
    # Извлечение полного идентификатора конфигурации (например, network.@interface[0])
    config_id="${line%%.proto=*}"
    # Удаление префикса "network." для получения имени/индекса интерфейса
    interface_id="${config_id#network.}"
    rai_raw=$(uci show | grep "amneziawg_${interface_id}" | grep route_allowed_ips)
    nohostroute=$(uci get "${config_id}.nohostroute" 2>/dev/null)
    # Проверка nohostroute: ошибка, если значение не равно "1"
