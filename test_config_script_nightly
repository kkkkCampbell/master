# Проверяем доступ к URL по каналу WARP через $IFACE
# $1 - TEST_URL
# $2 - что проверяем:
#	$2 = "" открытый ресурс
#	$2 != "" закрытый ресурс

check_WARP() {
	# Сначала пробуем TLSv1.3
	for tls_ver in tlsv1.3 tlsv1.2; do
		for attempt in $(seq 1 $MAX_RETRIES); do
			TRY=$((TRY + 1))
			FULL_OUT=$(curl -4 -I -A -s --no-progress-meter --user-agent 'Mozilla/5.0' \
				--interface "$IFACE" --max-time 20 --connect-timeout 5 \
				--insecure --$tls_ver "$1" 2>&1)
			W_CODE=$(echo "$FULL_OUT" | awk '/HTTP\// {print; exit}')
			if [ -n "$W_CODE" ]; then
				if [ -z "$2" ]; then
					RKN_WARP_BLOCK=1
					break 2   # выходим из двух циклов
				else
					SUCCESS=1
					FINAL_W_CODE="$W_CODE"
					FINAL_TLS="$tls_ver"
					FINAL_FULL_OUT="$FULL_OUT"
					break 2   # выходим из двух циклов
				fi
			fi
			# если не успех, продолжаем
		done
	done
}


# --- ФУНКЦИЯ: УНИКАЛЬНЫЙ КЛЮЧ КАНАЛА ---
get_channel_key() {
    s="$1"
    t=$(uci -q get ${UCI_CONFIG}.$s.connection_type)
    i=$(uci -q get ${UCI_CONFIG}.$s.interface)
    pct=$(uci -q get ${UCI_CONFIG}.$s.proxy_config_type)
    oj=$(uci -q get ${UCI_CONFIG}.$s.outbound_json)
    ps=$(uci -q get ${UCI_CONFIG}.$s.proxy_string)

    if [ "$t" = "vpn" ] && [ -n "$i" ]; then
        echo "vpn:$i"
        return 0
    fi

    if [ "$t" != "proxy" ]; then
        echo "unknown:$s"
        return 1
    fi

    if [ "$pct" = "outbound" ] && [ -n "$oj" ]; then
        typ=$(echo "$oj" | jq -r '.type // "unknown"')
        server=$(echo "$oj" | jq -r '.server // ""')
        port=$(echo "$oj" | jq -r '.server_port // ""')
        if [ "$server" = "127.0.0.1" ] && [ -n "$port" ]; then
            echo "outbound:$typ:local:$port"
        else
            echo "outbound:$typ:$server:$port"
        fi
        return 0
    fi

    if [ -n "$ps" ]; then
        scheme=$(echo "$ps" | sed -n 's|^\([a-z0-9]*\)://.*|\1|p')
        [ -z "$scheme" ] && scheme="proxy"
        base_ps=$(echo "$ps" | sed 's/?.*//')
        echo "proxy:$scheme:$base_ps"
        return 0
    fi

    echo "unknown:$s"
    return 1
}

# --- ФУНКЦИЯ: КРАСИВОЕ ОПИСАНИЕ КАНАЛА ---
get_channel_desc() {
    s="$1"
    t=$(uci -q get ${UCI_CONFIG}.$s.connection_type)
    i=$(uci -q get ${UCI_CONFIG}.$s.interface)
    pct=$(uci -q get ${UCI_CONFIG}.$s.proxy_config_type)
    oj=$(uci -q get ${UCI_CONFIG}.$s.outbound_json)
    ps=$(uci -q get ${UCI_CONFIG}.$s.proxy_string)

    if [ "$t" = "vpn" ] && [ -n "$i" ]; then
        echo "VPN $i"
        return 0
    fi

    if [ "$t" != "proxy" ]; then
        echo "?"
        return 1
    fi

    if [ "$pct" = "outbound" ] && [ -n "$oj" ]; then
        typ=$(echo "$oj" | jq -r '.type // "unknown"')
        typ=$(echo "$typ" | tr 'a-z' 'A-Z')
        server=$(echo "$oj" | jq -r '.server // ""')
        port=$(echo "$oj" | jq -r '.server_port // ""')
        if [ "$server" = "127.0.0.1" ] && [ -n "$port" ]; then
            echo "Outbound $typ local:$port"
        else
            echo "Outbound $typ"
        fi
        return 0
    fi

    if [ -n "$ps" ]; then
        scheme=$(echo "$ps" | sed -n 's|^\([a-z0-9]*\)://.*|\1|p')
        [ -z "$scheme" ] && scheme="proxy"
        scheme=$(echo "$scheme" | tr 'a-z' 'A-Z')

        if echo "$ps" | grep -q '@127.0.0.1'; then
            port=$(echo "$ps" | sed -n 's|.*://[^@]*@127.0.0.1:\([0-9]*\).*|\1|p')
            [ -n "$port" ] && echo "$scheme local:$port" || echo "$scheme local"
        else
            transport=$(echo "$ps" | grep -o 'type=[^&]*' | head -1 | cut -d= -f2 | tr 'a-z' 'A-Z')
            security=$(echo "$ps" | grep -o 'security=[^&]*' | head -1 | cut -d= -f2 | tr 'a-z' 'A-Z')
            if [ -n "$transport" ] && [ -n "$security" ]; then
                echo "$scheme + $transport + $security"
            else
                if [ -n "$transport" ]; then
                    echo "$scheme + $transport"
                else
                    if [ -n "$security" ]; then
                        echo "$scheme + $security"
                    else
                        echo "$scheme"
                    fi
                fi
            fi
        fi
        return 0
    fi

    echo "?"
    return 1
}

	# --- ФУНКЦИЯ ДЛЯ ПОЛУЧЕНИЯ ЗАДЕРЖКИ ЧЕРЕЗ API ZB|PK ---
get_delay() {
    _proxy_name="$1"
    _secret="$2"
    for i in $(seq 1 $RETRIES_API); do
        if [ -n "$_secret" ]; then
            resp=$(curl -s -H "Authorization: Bearer $_secret" "http://${LAN_IP}:9090/proxies/${_proxy_name}/delay?url=${TEST_API_URL}&timeout=${TIMEOUT_API}")
        else
            resp=$(curl -s "http://${LAN_IP}:9090/proxies/${_proxy_name}/delay?url=${TEST_API_URL}&timeout=${TIMEOUT_API}")
        fi
        delay=$(echo "$resp" | jq -r '.delay // ""')
        if [ -n "$delay" ] && [ "$delay" -gt 0 ] 2>/dev/null; then
            echo "$delay"
            return 0
        fi
        sleep 1
    done
    echo ""
    return 1
}


